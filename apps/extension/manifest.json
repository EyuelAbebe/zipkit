{
  "manifest_version": 3,
  "name": "ZipKit - Archive Manager",
  "version": "0.1.0",
  "description": "Zip. Unzip. Pack. Unpack. Inspect. Scan. A modern, secure archive utility with built-in security scanning.",
  "author": "Eyuel Abebe",
  "homepage_url": "https://github.com/eyuelabebe/zipkit",
  "permissions": ["storage", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZipKit - Archive Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
