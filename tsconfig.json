{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@zipkit/archive-core": ["./packages/archive-core/src"],
      "@zipkit/archive-security": ["./packages/archive-security/src"],
      "@zipkit/shared": ["./packages/shared/src"],
      "@zipkit/ui": ["./packages/ui/src"]
    },
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true
  },
  "exclude": ["node_modules", "**/dist", "**/build", "out", "coverage", "**/*.js", "**/*.d.ts"]
}
