{
  "name": "zipkit",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Zip. Unzip. Pack. Unpack. Inspect. Scan. A modern Chrome extension and browser-based archive utility.",
  "keywords": [
    "zip",
    "archive",
    "compression",
    "chrome-extension",
    "browser",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyuelabebe/zipkit.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo 'Tests not yet implemented' && exit 0",
    "test:unit": "echo 'Unit tests not yet implemented' && exit 0",
    "test:integration": "echo 'Integration tests not yet implemented' && exit 0",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf node_modules dist build out coverage .nyc_output",
    "release:verify": "scripts/release/verify.sh",
    "release:rc": "scripts/release/create-rc.sh",
    "release:promote": "scripts/release/promote.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
